---
// Pagina de detalle para los proyectos SIN `href`: se genera a partir del
// texto del .md. Los que tienen `href` llevan a su propia pagina y no pasan
// por aqui.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getProjects } from '../../lib/projects';
import { SITE_URL } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((p) => !p.data.href).map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { title, summary, category, status, tags, date, repo, draft } = project.data;
const { Content } = await render(project);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    description: summary,
    url: `${SITE_URL}/projects/${project.id}/`,
    dateCreated: date.toISOString(),
    keywords: tags.join(', '),
    author: { '@id': `${SITE_URL}/#org` },
    ...(repo && { codeRepository: repo }),
  },
];
---

<BaseLayout title={title} description={summary} type="article" noindex={draft} jsonLd={jsonLd}>
  <article class="container article">
    <a href="/projects/" class="back mono">← proyectos</a>

    <header>
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        <div><dt>Estado</dt><dd>{status}</dd></div>
        <div><dt>Fecha</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
        {tags.length > 0 && <div><dt>Stack</dt><dd>{tags.join(' · ')}</dd></div>}
      </dl>
      {repo && (
        <a href={repo} class="btn" rel="noopener" target="_blank">
          Ver el código
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article { max-width: 820px; padding-top: clamp(40px, 7vw, 88px); }
  .back { font-size: 0.85rem; color: var(--text-muted); }
  .back:hover { color: var(--text); }

  header { display: grid; justify-items: start; gap: 1.1rem; margin-top: 2.2rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
  h1 { font-size: clamp(2.4rem, 6vw, 4rem); letter-spacing: -0.04em; }
  .summary { color: var(--text-muted); font-size: 1.18rem; max-width: 56ch; }

  .facts { display: flex; flex-wrap: wrap; gap: 0.5rem 2.2rem; margin: 0.4rem 0 0.6rem; }
  .facts dt { font: 500 0.72rem/1 var(--ff-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .facts dd { margin: 0.4rem 0 0; font-size: 0.95rem; }

  /* Estilos para el texto del .md */
  .prose { padding-top: 2.5rem; color: #d9d4e6; font-size: 1.08rem; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { margin-top: 2.2em; font-size: 1.7rem; }
  .prose :global(h3) { margin-top: 1.8em; font-size: 1.3rem; }
  .prose :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(code) { font-family: var(--ff-mono); font-size: 0.88em; padding: 0.15em 0.4em; border-radius: 6px; background: rgb(255 255 255 / 0.07); color: var(--cyan); }
  .prose :global(pre) { padding: 1.1rem 1.2rem; border-radius: 12px; border: 1px solid var(--border); background: #0e0a18 !important; overflow-x: auto; font-size: 0.88rem; }
  .prose :global(pre code) { padding: 0; background: none; color: inherit; }
  .prose :global(blockquote) { margin-inline: 0; padding-left: 1.1rem; border-left: 3px solid var(--violet); color: var(--text-muted); }
  .prose :global(img) { border-radius: 12px; border: 1px solid var(--border); }

  /* Colores del resaltado de codigo (Prism) */
  .prose :global(.token.comment), .prose :global(.token.prolog) { color: var(--text-dim); font-style: italic; }
  .prose :global(.token.keyword), .prose :global(.token.builtin) { color: var(--violet); }
  .prose :global(.token.string), .prose :global(.token.char) { color: var(--ok); }
  .prose :global(.token.number), .prose :global(.token.boolean), .prose :global(.token.constant) { color: var(--warn); }
  .prose :global(.token.function), .prose :global(.token.class-name) { color: var(--cyan); }
  .prose :global(.token.operator), .prose :global(.token.punctuation) { color: var(--text-muted); }
  .prose :global(.token.variable), .prose :global(.token.parameter) { color: var(--blue); }
</style>
