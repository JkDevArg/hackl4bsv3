---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark.png';
import { getProjects } from '../lib/projects';
import { COMMUNITY, SITE } from '../site.config';

const projects = await getProjects();
// El lema se parte para resaltar la ultima palabra ("Together").
const sloganWords = SITE.slogan.split(' ');
const sloganLast = sloganWords.pop();
---

<section class="hero">
  <div class="container grid">
    <div class="copy">
      <p class="chip"><span class="pulse" aria-hidden="true"></span>{SITE.tagline}</p>

      <h1 lang="en">
        {sloganWords.join(' ')} <span class="grad-text">{sloganLast}</span>
      </h1>

      <p class="lead">{SITE.description}</p>

      <div class="ctas">
        <a href="/projects/" class="btn btn-primary">
          Ver proyectos
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
        <a href={COMMUNITY.href} class="btn" rel="noopener" target="_blank">
          Únete en {COMMUNITY.label}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>

    {/* Decorativo: la misma informacion esta en la seccion de proyectos */}
    <div class="visual" aria-hidden="true">
      <div class="aura"></div>
      <div class="orbit o1"><span></span></div>
      <div class="orbit o2"><span></span></div>
      {/* 254 px es el tamano real del isotipo en el logo original: pedir mas
           solo genera copias iguales. Con un logo en mayor resolucion, subelo. */}
      <Image src={mark} alt="" class="mark" width={254} quality={82} loading="eager" fetchpriority="high" />

      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i><span>~/hackl4bs</span></div>
        <div class="code">
          <p><span class="p">❯</span> ls projects/</p>
          {projects.map((p) => (
            <p class="row">
              <span class="name">{p.id}/</span>
              <span class={`st st-${p.data.status.replace(' ', '-')}`}>{p.data.status}</span>
            </p>
          ))}
          <p><span class="p">❯</span> <span class="cursor"></span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(48px, 9vw, 112px); }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(40px, 6vw, 80px);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font: 500 0.78rem/1 var(--ff-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }
  .pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ok);
    animation: ping 2.2s var(--ease) infinite;
  }

  h1 {
    margin-top: 1.6rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .lead {
    margin-top: 1.6rem;
    max-width: 52ch;
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    color: var(--text-muted);
  }

  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.2rem; }

  /* --- Visual ------------------------------------------------------------ */
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
  }
  .aura {
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--violet-deep), #3b82f6, var(--cyan), #a855f7, var(--violet-deep));
    filter: blur(60px);
    opacity: 0.45;
    animation: rotate 18s linear infinite;
  }
  .orbit {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(179 138 245 / 0.18);
    animation: rotate 24s linear infinite;
  }
  .orbit span {
    position: absolute;
    top: -4px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 14px var(--cyan);
  }
  .o1 { inset: 6%; }
  .o2 { inset: 20%; border-style: dashed; border-color: rgb(122 150 246 / 0.2); animation-duration: 36s; animation-direction: reverse; }
  .o2 span { background: var(--violet); box-shadow: 0 0 14px var(--violet); }

  .mark {
    position: relative;
    width: 58%;
    filter: drop-shadow(0 0 40px rgb(139 92 246 / 0.55));
    animation: float 7s ease-in-out infinite;
  }

  .term {
    position: absolute;
    left: -6%;
    bottom: 2%;
    min-width: 250px;
    border-radius: 14px;
    border: 1px solid var(--border-strong);
    background: rgb(14 9 26 / 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    font: 400 0.72rem/1 var(--ff-mono);
    color: var(--text-dim);
  }
  .term-bar i { width: 9px; height: 9px; border-radius: 50%; background: rgb(255 255 255 / 0.14); }
  .term-bar span { margin-left: 6px; }
  .code {
    padding: 14px 16px 16px;
    font: 400 0.82rem/1.75 var(--ff-mono);
    color: var(--text);
  }
  .code p { white-space: nowrap; }
  .p { color: var(--violet); }
  .row { display: flex; justify-content: space-between; gap: 2.5rem; padding-left: 1.2em; }
  .name { color: var(--cyan); }
  .st { color: var(--ok); }
  .st-beta,
  .st-en-desarrollo { color: var(--warn); }
  .st-archivado { color: var(--off); }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: -0.15em;
    background: var(--violet);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes rotate { to { transform: rotate(360deg); } }
  @keyframes float { 50% { transform: translateY(-12px); } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes ping { 75%, 100% { transform: scale(2.6); opacity: 0; } }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .visual { max-width: 380px; }
    .term { left: 0; }
  }
</style>
