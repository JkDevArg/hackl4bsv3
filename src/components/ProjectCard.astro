---
import { Image } from 'astro:assets';
import { formatDate, isExternal, projectHref, type Project } from '../lib/projects';

export interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}
const { project, headingLevel: H = 'h3' } = Astro.props;
const { title, summary, category, status, tags, date, cta, cover, draft } = project.data;
const href = projectHref(project);
const external = isExternal(href);
---

<article class="card" data-status={status}>
  {cover && (
    <div class="cover">
      {/* Se recorta a 16:9 al compilar: la tarjeta no muestra mas, asi que
          no se descargan pixeles que no se ven. */}
      <Image src={cover} alt="" width={800} height={450} fit="cover" position="center" widths={[400, 800]} sizes="(max-width: 720px) 100vw, 400px" />
    </div>
  )}

  <div class="meta">
    <span class="category">{category}</span>
    <span class="status"><span class="dot" aria-hidden="true"></span>{status}</span>
  </div>

  <H class="title">
    <a href={href} rel={external ? 'noopener' : undefined} target={external ? '_blank' : undefined}>
      {title}
      {draft && <span class="draft">borrador</span>}
    </a>
  </H>

  <p class="summary">{summary}</p>

  {tags.length > 0 && (
    <ul role="list" class="tags" aria-label="Etiquetas">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  )}

  <div class="foot">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <span class="cta" aria-hidden="true">
      {cta}
      <svg viewBox="0 0 16 16"><path d={external ? 'M5 11 11 5M6 5h5v5' : 'M3 8h10M9 4l4 4-4 4'} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </div>
</article>

<style>
  /* Toda la tarjeta es clicable (el <a> del titulo se estira con ::after), pero
     solo hay un enlace: los lectores de pantalla no oyen el mismo destino tres
     veces. */
  .card {
    --status: var(--ok);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 26px;
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.015));
    border: 1px solid var(--border);
    transition: transform 0.35s var(--ease), border-color 0.35s, box-shadow 0.35s;
  }
  .card[data-status='beta'],
  .card[data-status='en desarrollo'] { --status: var(--warn); }
  .card[data-status='archivado'] { --status: var(--off); }

  /* Borde con degradado que aparece al pasar el raton */
  .card::before {
    content: '';
    position: absolute;
    inset: -1px;
    z-index: -1;
    padding: 1px;
    border-radius: inherit;
    background: conic-gradient(from var(--angle, 0deg), var(--violet), var(--blue), var(--cyan), var(--violet-deep), var(--violet));
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    border-color: transparent;
    box-shadow: 0 24px 60px -24px var(--glow-violet);
  }
  .card:hover::before,
  .card:focus-within::before { opacity: 1; }

  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card:hover::before { animation: spin 4s linear infinite; }
  }
  @keyframes spin { to { --angle: 360deg; } }

  .cover {
    margin: -26px -26px 0;
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
  }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font: 500 0.74rem/1 var(--ff-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .category { color: var(--violet); }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status);
    box-shadow: 0 0 10px var(--status);
  }

  .title { font-size: 1.6rem; letter-spacing: -0.02em; }
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .card:has(.title a:focus-visible) { outline: 2px solid var(--cyan); outline-offset: 3px; }

  .draft {
    margin-left: 0.6rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: rgb(232 180 74 / 0.15);
    color: var(--warn);
    font: 500 0.7rem/1 var(--ff-mono);
    vertical-align: middle;
  }

  .summary { color: var(--text-muted); font-size: 0.98rem; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tags li {
    padding: 0.3rem 0.6rem;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.05);
    font: 400 0.75rem/1.2 var(--ff-mono);
    color: var(--text-muted);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .foot time { font-family: var(--ff-mono); font-size: 0.78rem; }
  .cta { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text); font-weight: 500; }
  .cta svg { width: 15px; height: 15px; transition: transform 0.3s var(--ease); }
  .card:hover .cta svg { transform: translateX(3px); }
</style>
