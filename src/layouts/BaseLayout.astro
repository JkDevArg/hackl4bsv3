---
import { Font } from 'astro:assets';
import SEO, { type Props as SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';
import '../styles/global.css';

export type Props = SEOProps;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />

    {/* Sin preload a proposito: el @font-face va inline aqui mismo, asi que el
         navegador lo descubre igual de pronto, y un preload forzaria a bajar
         todos los subconjuntos (latin-ext incluido) aunque la pagina no los use. */}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-mono" />

    <SEO {...Astro.props} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .skip-link:focus { top: 12px; }
</style>
